{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "constellation-api",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-p",
        "constellation-serve",
        "--",
        "--db",
        "data/constellation.duckdb"
      ],
      "port": 8000
    },
    {
      "name": "constellation-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "constellation-agent",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "agent/src/server.ts"
      ],
      "port": 8787
    }
  ]
}
