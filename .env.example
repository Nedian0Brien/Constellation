# OpenAlex — https://openalex.org  (무료 발급)
OPENALEX_API_KEY=
OPENALEX_MAILTO=you@example.com

# Semantic Scholar — 선택. 없으면 공용 한도(429가 잦다). 무료 발급:
# https://www.semanticscholar.org/product/api  (키 기본 한도 초당 1회)
SEMANTIC_SCHOLAR_API_KEY=

# Scopus — 기관 구독 필요. 미확보 시 비워둔다
SCOPUS_API_KEY=
SCOPUS_INSTTOKEN=

# Optional data directory; relative paths resolve from the repository root
# CONSTELLATION_DATA_DIR=data
